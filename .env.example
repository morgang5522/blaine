# Telegram Bot Secrets
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyZ"
TELEGRAM_ALLOWED_USERS="123456789" # Your numeric Telegram User ID for security whitelist

# AI / LLM Configuration
LLM_PROVIDER="gemini"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL_NAME="gemini-3.1-flash-lite"

# Redis Queue Configuration
REDIS_HOST="redis"
REDIS_PORT="6379"

# Host Mount Path Configuration (Defaults to ./data for local dev on Mac/Windows, or /var/blaine on Linux server)
BLAINE_DATA_DIR="./data"
RCLONE_CONFIG_DIR="~/.config/rclone"

# Storage & SQLite Settings (Internal container paths)
SCRATCH_DIR="/var/blaine/scratch"
ORGANIZED_DIR="/var/blaine/organized"
SQLITE_DB_PATH="/var/blaine/blaine.db"

# Cloud Storage Remotes (Configured in Rclone)
MEGA_S3_REMOTE="mega-s3:blaine-archives"
GDRIVE_REMOTE="gdrive:BlaineMedia"

# Web Search API Settings (Brave Search API Key)
BRAVE_API_KEY="BSA..." # Optional: Get free key at https://brave.com/search/api/