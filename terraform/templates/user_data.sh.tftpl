#!/usr/bin/env bash
set -euo pipefail

# Log all cloud-init output
exec > >(tee -a /var/log/blaine-setup.log) 2>&1
echo "=== Starting Blaine Hardened Non-Root Deployment: $(date) ==="

# 1. Update system & install dependencies
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    git \
    ffmpeg \
    rclone \
    htop \
    sudo \
    ufw

# 2. Install Docker & Docker Compose plugin
if ! command -v docker &> /dev/null; then
    echo "Installing Docker..."
    curl -fsSL https://get.docker.com | sh
    systemctl enable --now docker
fi
apt-get install -y docker-compose-plugin

# 3. Create non-root system user 'blaine' safely
echo "Creating system user 'blaine'..."
if ! getent group blaine >/dev/null; then
    groupadd blaine
fi
if ! id -u blaine >/dev/null 2>&1; then
    useradd -m -g blaine -s /bin/bash blaine
fi
usermod -aG docker blaine || true

# 4. Setup SSH access for 'blaine' user
echo "Configuring SSH key for 'blaine' user..."
mkdir -p /home/blaine/.ssh /root/.ssh
chmod 700 /home/blaine/.ssh /root/.ssh

# Authorize server_public_key for blaine user SSH access
cat <<'EOF' > /home/blaine/.ssh/authorized_keys
${server_public_key}
EOF

# Append any DigitalOcean injected keys (such as user_public_ssh_key)
if [ -f /root/.ssh/authorized_keys ]; then
    cat /root/.ssh/authorized_keys >> /home/blaine/.ssh/authorized_keys
fi

# Ensure unique entries and correct permissions
sort -u /home/blaine/.ssh/authorized_keys -o /home/blaine/.ssh/authorized_keys
chmod 600 /home/blaine/.ssh/authorized_keys

%{ if github_deploy_private_key != "" }
# GitHub Deploy Key Pair (for private repo access via SSH)
cat <<'EOF' > /home/blaine/.ssh/id_github_deploy
${github_deploy_private_key}
EOF
chmod 600 /home/blaine/.ssh/id_github_deploy

cat <<'EOF' > /home/blaine/.ssh/id_github_deploy.pub
${github_deploy_public_key}
EOF
chmod 644 /home/blaine/.ssh/id_github_deploy.pub

# SSH client config for GitHub
cat <<'EOF' > /home/blaine/.ssh/config
Host github.com
    HostName github.com
    User git
    IdentityFile /home/blaine/.ssh/id_github_deploy
    StrictHostKeyChecking no
EOF
chmod 600 /home/blaine/.ssh/config

ssh-keyscan github.com >> /home/blaine/.ssh/known_hosts 2>/dev/null || true
%{ endif }

chown -R blaine:blaine /home/blaine/.ssh

# 5. Create storage directories and set ownership
mkdir -p /opt/blaine
mkdir -p /var/blaine/scratch /var/blaine/organized
mkdir -p /home/blaine/.config/rclone
chown -R blaine:blaine /opt/blaine /var/blaine /home/blaine/.config

# 6. Clone private Git repository as 'blaine' user
echo "Cloning Blaine codebase from ${git_repo_url} as blaine user..."
rm -rf /opt/blaine/* /opt/blaine/.* 2>/dev/null || true
sudo -u blaine git clone "${git_repo_url}" /opt/blaine

# 7. Inject application environment variables
echo "Generating /opt/blaine/.env..."
cat <<EOF > /opt/blaine/.env
TELEGRAM_BOT_TOKEN=${telegram_bot_token}
GEMINI_API_KEY=${gemini_api_key}
DATA_DIR=/var/blaine
LOG_LEVEL=INFO
EOF
chown blaine:blaine /opt/blaine/.env
chmod 600 /opt/blaine/.env

# 8. Decode rclone config if provided
%{ if rclone_config_base64 != "" }
echo "Configuring rclone..."
echo "${rclone_config_base64}" | base64 -d > /home/blaine/.config/rclone/rclone.conf
chown blaine:blaine /home/blaine/.config/rclone/rclone.conf
chmod 600 /home/blaine/.config/rclone/rclone.conf
%{ endif }

# 9. Launch Docker Compose stack as 'blaine' user
echo "Building and launching Blaine Docker stack as blaine user..."
sudo -u blaine bash -c "cd /opt/blaine && docker compose down || true"
sudo -u blaine bash -c "cd /opt/blaine && docker compose up -d --build"

# 10. Register systemd service for auto-start on server reboot
cat <<'EOF' > /etc/systemd/system/blaine.service
[Unit]
Description=Blaine AI Stack Docker Service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=blaine
Group=blaine
WorkingDirectory=/opt/blaine
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable blaine.service

# 11. Helper script for 1-command redeployments
cat <<'EOF' > /opt/blaine/redeploy.sh
#!/usr/bin/env bash
set -e
cd /opt/blaine
echo "Pulling latest changes from Git..."
git pull
echo "Rebuilding and restarting Docker containers..."
docker compose up -d --build
echo "Redeployment completed cleanly!"
EOF
chown blaine:blaine /opt/blaine/redeploy.sh
chmod +x /opt/blaine/redeploy.sh

echo "=== Hardened Non-Root Blaine Droplet Deployment Complete: $(date) ==="
